<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jeffch.arbor</groupId>
        <artifactId>Arbor</artifactId>
        <version>1.0.0-SNAPSHOT-2</version>
    </parent>

    <artifactId>ArborCore</artifactId>
    <name>ArborCore</name>
    <description>Tree generation, presets, voxelizing and schematic export. No GUI or OpenGL.</description>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pepsoft.jnbt</groupId>
            <artifactId>JNBT</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/../presets</directory>
                <targetPath>presets</targetPath>
            </resource>
        </resources>
    </build>
</project>
